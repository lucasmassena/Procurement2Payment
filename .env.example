# Copie este arquivo para .env e preencha os valores reais

# Slack
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_MANAGER_CHANNEL=#strategy-ai-test

# Gemini
GEMINI_API_KEY=AIza...

# Google SSO
# Crie em: https://console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client ID
# Tipo: Web application | Authorized JS origins: http://localhost:3000 | Authorized redirect URIs: http://localhost:3000
GOOGLE_CLIENT_ID=335197849560-ap8583hlf83nl2b24leabcvmouqmiia3.apps.googleusercontent.com

# Domínio corporativo permitido (sem @, apenas o domínio)
ALLOWED_DOMAIN=vtex.com

# Lista de e-mails com acesso autorizado (separados por vírgula)
# Se vazio, qualquer @vtex.com pode entrar. Se preenchido, apenas estes e-mails.
ALLOWED_EMAILS=email1@vtex.com,email2@vtex.com
